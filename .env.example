# ============================================================
# KindBite — Environment Variables Example
# Copy to .env and fill in your values. NEVER commit .env.
# ============================================================

# ---- Application ----
APP_ENV=development
APP_NAME=KindBite
APP_URL=http://localhost:3000

# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=CHANGE_ME_use_a_64_char_random_string_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Database (PostgreSQL) ----
# If using Docker Compose: postgres://kindbite:kindbite_dev_pass@localhost:5432/kindbite
DATABASE_URL=postgresql+asyncpg://kindbite:kindbite_dev_pass@localhost:5432/kindbite
# Sync URL for Alembic migrations
DATABASE_SYNC_URL=postgresql://kindbite:kindbite_dev_pass@localhost:5432/kindbite

# ---- CORS ----
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Email (optional for development) ----
# Leave empty to use development email mode (emails printed to console/log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@kindbite.in

# ---- File Uploads ----
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# ---- ML ----
ML_MODELS_DIR=./ml/models/artifacts
ML_DATA_DIR=./data
SYNTHETIC_SEED=42

# ---- Mapping (optional) ----
# Leave empty to use simulated distances (development mode)
GOOGLE_MAPS_API_KEY=

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=development
